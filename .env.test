# Test environment.
#
# Deliberately fake. The suite runs against PGlite — PostgreSQL compiled to
# WebAssembly, created fresh per test file — and stubs every external provider,
# so nothing here is ever dialled. These values exist only to satisfy the
# environment schema at import time.
#
# This file IS committed. Never put a real credential in it.
NODE_ENV=test
DATABASE_URL=postgresql://test:test@localhost:5432/test
DATABASE_SSL=false
SUPABASE_URL=https://test.supabase.co
SUPABASE_ANON_KEY=test-anon-key-not-a-real-key-000000
SUPABASE_SERVICE_ROLE_KEY=test-service-role-key-not-real-000
APP_SECRET=test-secret-for-webhook-signing-32-chars-min
SIGNATURE_PROVIDER=manual
EMAIL_PROVIDER=noop
RATE_LIMIT_ENABLED=false
LOG_LEVEL=error
